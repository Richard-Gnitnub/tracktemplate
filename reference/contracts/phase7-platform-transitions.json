    "functions": {
      "platform_transition_displacement": {
        "parameters": [
          "length",
          "radius",
          "shape_parameter",
          "transition_kind",
          "integration_steps"
        ],
        "defaults": {
          "integration_steps": 320
        },
        "result": [
          "dx",
          "dy",
          "angle"
        ],
        "transition_kinds": [
          "entry",
          "exit"
        ],
        "geometry_tolerance": 1e-08,
        "minimum_integration_steps": 80,
        "integration_step_multiple": 2,
        "invalid_shape_lower_bound_expression": "-0.25 - 1.0e-10",
        "zero_length_precedes_shape_and_kind_validation": true
      },
      "platform_peak_curvature_factor": {
        "parameters": [
          "shape_parameter"
        ],
        "defaults": {},
        "minimum_result": 1.0,
        "root_zero_tolerance": 1e-14,
        "candidate_order": [
          "u=0.0",
          "u=1.0",
          "interior roots"
        ]
      },
      "platform_transition_angle": {
        "parameters": [
          "length",
          "radius",
          "shape_parameter"
        ],
        "defaults": {},
        "geometry_tolerance": 1e-08,
        "expression": "(length / radius) * (0.5 + ((8.0 / 15.0) * shape_parameter))"
      },
      "platform_line_offset": {
        "parameters": [
          "circle_centre",
          "radius",
          "length",
          "shape_parameter",
          "total_angle",
          "transition_kind",
          "integration_steps"
        ],
        "defaults": {
          "integration_steps": 240
        },
        "normal": "_left_normal(total_angle)",
        "dot_product": "(centre_x * normal_x) + (centre_y * normal_y)"
      },
      "_platform_parameter_grid": {
        "parameters": [
          "lower",
          "upper"
        ],
        "defaults": {},
        "negative_crossing_steps": 36,
        "negative_only_steps": 80,
        "positive_quadratic_steps": 240,
        "endpoint_tolerance": 1e-12
      },
      "solve_platform_shape_parameter": {
        "parameters": [
          "circle_centre",
          "radius",
          "transition_length",
          "target_line_offset",
          "total_angle",
          "track_name",
          "end_name",
          "transition_kind"
        ],
        "defaults": {},
        "result_keys": [
          "shape_parameter",
          "angle",
          "peak_factor",
          "minimum_radius"
        ],
        "minimum_shape": -0.187499,
        "maximum_angle_floor": 1e-08,
        "maximum_angle_margin": 1e-08,
        "grid_integration_steps": 240,
        "golden_integration_steps": 360,
        "bisection_integration_steps": 320,
        "exact_sample_tolerance": 1e-07,
        "golden_residual_tolerance": 1e-05,
        "golden_iteration_limit": 72,
        "bisection_iteration_limit": 72,
        "bisection_residual_tolerance": 1e-10,
        "bisection_parameter_tolerance": 1e-09,
        "selection_order": [
          "-minimum_radius",
          "angle",
          "abs(shape_parameter)"
        ]
      }
    },
