    "input_mutation": false,
    "host_objects": false,
    "document_mutation": false,
    "cached": false,
    "diagnostics": [
      {
        "condition": "radius <= 0.0",
        "exception": "ValueError",
        "format_string": "The constant radius for '{}' must be greater than zero."
      },
      {
        "condition": "entry_transition < 0.0 or exit_transition < 0.0",
        "exception": "ValueError",
        "format_string": "Platform transition lengths for '{}' cannot be negative."
      },
      {
        "condition": "entry_shape_parameter < -0.25 - 1.0e-10",
        "exception": "ValueError",
        "format_string": "A platform-transition shape parameter became invalid."
      },
      {
        "condition": "exit_shape_parameter < -0.25 - 1.0e-10",
        "exception": "ValueError",
        "format_string": "A platform-transition shape parameter became invalid."
      },
      {
        "condition": "total_angle - entry_angle - exit_angle < -1.0e-8",
        "exception": "ValueError",
        "format_string": "The platform transitions for '{}' use more angle than the complete curve.\n\nEntry transition angle: {:.3f} deg\nExit transition angle: {:.3f} deg\nCombined transition angle: {:.3f} deg\nComplete turn angle: {:.3f} deg\n\nShorten one or both platform transition lengths. As a conservative starting point, try about {:.0f} mm entry and {:.0f} mm exit, then increase them if the macro confirms that the geometry still fits."
      }
    ],
    "operation_order": [
      "validate radius",
      "validate transition lengths",
      "calculate entry displacement and angle with 480 Simpson steps",
      "calculate exit displacement and angle with 480 Simpson steps",
      "validate and clamp the circular angle",
      "calculate and sample the entry transition",
      "snap the entry endpoint to the calculated circle start",
      "calculate and sample the constant-radius segment",
      "snap the circular endpoint to the calculated circle end",
      "calculate and sample the exit transition",
      "snap the exit endpoint to the independently calculated displacement",
      "set the final heading and minimum-radius metadata",
      "return the ordered result"
    ]
  },
