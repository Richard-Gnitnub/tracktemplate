#!/usr/bin/env bash
set -euo pipefail
PATH=/bin:/usr/bin
export PATH

bridge_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd "${bridge_dir}/../.." && pwd)"
"${project_root}/.venv/bin/python" \
    "${project_root}/tools/validation_execution_policy.py" \
    --workload freecad-gui-bridge \
    --local-owner-exception "${TRACKTEMPLATE_LOCAL_VALIDATION_EXCEPTION:-}"
guard="${project_root}/tools/freecad_validation_guard.py"
entry="${bridge_dir}/run-isolated"
if [[ "${TRACKTEMPLATE_VALIDATION_RESERVED_ENTRY:-}" != "${entry}" ]]; then
    exec "${project_root}/.venv/bin/python" "${guard}" reserve-gui "${entry}" "$@"
fi
"${project_root}/.venv/bin/python" "${guard}" verify-gui-lease
state_dir="${project_root}/benchmark-output/freecad-bridge"
launcher_log="${TRACKTEMPLATE_BRIDGE_LAUNCHER_LOG:-${state_dir}/isolated-launcher.log}"
instance_file="${TRACKTEMPLATE_BRIDGE_INSTANCE_FILE:-${state_dir}/isolated-instance-id}"

if [[ "$#" -eq 0 ]]; then
    echo "Usage: tools/freecad_bridge/run-isolated COMMAND [ARG ...]" >&2
    exit 2
fi
if "${bridge_dir}/freecad-cli" ping >/dev/null 2>&1; then
    echo "A bridge session is already running; isolation requires port 19875 to be free." >&2
    exit 2
fi

mkdir -p "${state_dir}"
isolated_temp_dir="$(mktemp -d "${state_dir}/isolated-temp.XXXXXX")"
PYTHONDONTWRITEBYTECODE=1
PYTHONPYCACHEPREFIX="${isolated_temp_dir}/python-cache"
export PYTHONDONTWRITEBYTECODE PYTHONPYCACHEPREFIX
: >"${instance_file}"
TRACKTEMPLATE_BRIDGE_INSTANCE_FILE="${instance_file}" \
TRACKTEMPLATE_BRIDGE_TEMP_DIR="${isolated_temp_dir}" \
TRACKTEMPLATE_VALIDATION_EVIDENCE_DIR="${isolated_temp_dir}/guard" \
    "${bridge_dir}/launch-freecad" >"${launcher_log}" 2>&1 &
freecad_process=$!

cleanup() {
    cleanup_status=0
    if kill -0 "${freecad_process}" >/dev/null 2>&1; then
        "${project_root}/.venv/bin/python" "${guard}" request-gui-stop \
            "${isolated_temp_dir}/guard" "${freecad_process}" \
            "${command_status}" || cleanup_status=1
        for _shutdown_attempt in $(seq 1 80); do
            if ! kill -0 "${freecad_process}" >/dev/null 2>&1; then
                break
            fi
            sleep 0.25
        done
    fi
    if kill -0 "${freecad_process}" >/dev/null 2>&1; then
        echo "Validation supervisor remains active; deadline and evidence retained." >&2
        cleanup_status=1
    else
        wait "${freecad_process}" >/dev/null 2>&1 || true
        "${project_root}/.venv/bin/python" "${guard}" check-gui-cleanup \
            "${isolated_temp_dir}/guard/result.json" \
            "${command_status}" || cleanup_status=1
    fi
    echo "Validation evidence retained: ${isolated_temp_dir}" >&2
    return "${cleanup_status}"
}

exit_cleanup() {
    command_status=$?
    trap - EXIT INT TERM
    cleanup_status=0
    cleanup || cleanup_status=$?
    if [[ "${cleanup_status}" -ne 0 ]]; then
        exit "${cleanup_status}"
    fi
    exit "${command_status}"
}

trap exit_cleanup EXIT
trap 'exit 130' INT TERM

ready=0
for _attempt in $(seq 1 90); do
    if ! kill -0 "${freecad_process}" >/dev/null 2>&1; then
        break
    fi
    if "${bridge_dir}/freecad-cli" ping >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
if [[ "${ready}" -ne 1 ]]; then
    echo "The isolated FreeCAD bridge did not become ready; see ${launcher_log}." >&2
    exit 1
fi

"$@"
